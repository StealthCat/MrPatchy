# Worker-only environment for compose.worker.yaml (and compose.worker.gcp.yaml).
# Copy to .env.worker and pass it explicitly:
#   docker compose -p mrpatchy-workers --env-file .env.worker -f compose.worker.yaml up -d --build --wait --scale worker=N
# The web app, Caddy, TLS, administrator password and OIDC belong to the controller's
# .env (see .env.example); none of them are read here. Never put credentials in this file
# other than in DATABASE_URL, and keep it readable only by the account that runs Compose.

# Required: the controller project's existing data volume (encryption key, SSH identities and
# SQLite data). It must already exist on this Docker host; list it with `docker volume ls`.
MRPATCHY_CONTROLLER_DATA_VOLUME=mrpatchy_app-data

# Database. Leave unset to use the controller's SQLite file on the shared volume (same host only).
# An activated encrypted database profile on the shared volume overrides this value.
# For MySQL 8+, use the controller's URL; URL-encode special characters in credentials.
# DATABASE_URL=mysql+pymysql://mrpatchy:password@mysql-host:3306/mrpatchy?charset=utf8mb4

# Startup-only per-replica pool limits; recreate the workers after changes.
# Jobs 1..8, polls 1..32, AI tasks 1..8 (default 4, use 1 for serial).
# AI HTTP connections 1..64 (default 16) is a per-process transport ceiling,
# not provider capacity or permission to exceed the AI task limit.
MRPATCHY_JOB_CONCURRENCY=2
MRPATCHY_POLL_CONCURRENCY=8
MRPATCHY_AI_CONCURRENCY=4
MRPATCHY_AI_HTTP_CONNECTIONS=16

# Drain window: SIGTERM lets active jobs finish. Patch SSH calls may run up to 7500 s.
MRPATCHY_WORKER_STOP_GRACE_PERIOD=8100s
# Per-replica memory ceiling; raise on large fleets.
MRPATCHY_WORKER_MEM_LIMIT=4g

# Expected inventory read by the coordinator tick, which runs in workers. Set the same values
# for every worker stack. compose.worker.yaml never assigns a fixed worker ID (each replica claims
# a generated one), so leave MRPATCHY_EXPECTED_WORKER_IDS empty: listed IDs would be reported missing.
# MRPATCHY_EXPECTED_WORKER_IDS=
# MRPATCHY_EXPECTED_CONTROLLER_IDS=patchy-controller-01

# Only with compose.worker.gcp.yaml: the same project and zone that install-gcp.sh wrote for the controller.
# GCP_PROJECT=my-project
# GCP_ZONE=us-central1-a
