# Controller-role environment for compose.controller.yaml (web app and Caddy only).
# Copy to .env next to compose.controller.yaml and edit before the first start:
#   cp .env.controller.example .env
# Workers use their own file: cp .env.worker.example .env.worker (see docs/COMPOSE_CONFIGURATION.md).
# For the complete single-machine compose.yaml installation, use .env.example instead.

# Set before initial start. After initial creation the password hash lives in the DB.
ADMIN_PASSWORD=replace-with-a-long-unique-password
DOMAIN=patchy.example.com
PUBLIC_URL=https://patchy.example.com
# Published host interface and ports. The app/admin API remain private to Docker.
BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Optional per-protocol interface overrides; otherwise both use BIND_IP.
# HTTP_BIND_IP=192.168.1.20
# HTTPS_BIND_IP=192.168.1.20
# For HTTPS_PORT=8443, use PUBLIC_URL=https://patchy.example.com:8443
# unless a router exposes a different external port. Profile port overrides live in the UI.
# DOMAIN initializes the internal profile only. Add the external profile in Settings → Configure HTTPS.

# Database. Workers must use the same database; an activated encrypted database profile
# overrides DATABASE_URL for the app and workers. URL-encode special characters in credentials.
# DATABASE_URL=mysql+pymysql://mrpatchy:password@mysql-host:3306/mrpatchy?charset=utf8mb4

# Optional OIDC SSO. Preserve the provider's exact issuer, including trailing slash.
# OIDC_ISSUER=https://identity.example.com/
# OIDC_CLIENT_ID=mrpatchy
# OIDC_CLIENT_SECRET=replace-with-your-provider-client-secret

# Dedicated control-network addresses. Change all three if this subnet overlaps your network.
# CONTROL_SUBNET=172.30.254.0/24
# CADDY_CONTROL_IP=172.30.254.2
# APP_CONTROL_IP=172.30.254.3

# Per-process AI HTTP connection ceiling for the app (1..64), not provider capacity.
MRPATCHY_AI_HTTP_CONNECTIONS=16

# Container memory limits; raise on large fleets.
# MRPATCHY_APP_MEM_LIMIT=2g
# MRPATCHY_CADDY_MEM_LIMIT=512m

# Expected inventory shown on the Workers page. Leave MRPATCHY_EXPECTED_WORKER_IDS empty with
# compose.worker.yaml: its replicas never take a fixed worker ID, so any listed ID is reported
# as a missing worker. Set it only for workers you start elsewhere with a fixed MRPATCHY_WORKER_ID.
MRPATCHY_EXPECTED_WORKER_IDS=
# MRPATCHY_EXPECTED_CONTROLLER_IDS=patchy-controller-01

# GCP controller overlay (compose.controller.gcp.yaml) only; install-gcp.sh can set these.
# GCP_PROJECT=my-project
# GCP_ZONE=us-central1-a

# Worker pool limits, worker IDs, drain window and the controller data-volume name are
# worker settings: they live in .env.worker, not here.
