# Test-only target: SSH/sudo are real; systemctl is a recorded stub.
ARG TARGET_BASE=ubuntu:24.04
FROM ${TARGET_BASE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 openssh-server sudo openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -c "import uuid,pathlib; pathlib.Path('/etc/machine-id').write_text(uuid.uuid4().hex+'\n')"
RUN mkdir -p /run/sshd && ssh-keygen -A && printf '%s\n' 'HostKey /etc/ssh/ssh_host_ed25519_key' 'PasswordAuthentication no' 'KbdInteractiveAuthentication no' 'UsePAM no' 'PermitRootLogin no' 'StrictModes yes' > /etc/ssh/sshd_config
RUN printf '%s\n' '#!/bin/sh' 'printf "%s\\n" "$*" >> /opt/drpatch/systemctl-test.log' '[ "$1" != is-active ] || echo active' 'exit 0' > /usr/bin/systemctl && chmod 755 /usr/bin/systemctl
COPY tests/fixtures/deb-package.sh /tmp/deb-package.sh
RUN bash /tmp/deb-package.sh
EXPOSE 22
CMD ["/usr/sbin/sshd","-D","-e"]
